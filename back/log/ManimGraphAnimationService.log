from manim import *

class UnitCircleAngleMotion(Scene):
    def construct(self):
        # --- Setup ---
        self.camera.background_color = WHITE

        # Unit Circle and Point P
        unit_circle = Circle(radius=1, color=WHITE)
        origin = ORIGIN
        p = Dot(radius=0.08, color=WHITE)
        angle_label = MathTex(r"\theta")
        coord_label = MathTex(r"(cos\theta, sin\theta)")
        # ... Add axes, dashed lines, initial labels ...

        # Table of Values
        headers = ["\\theta (°)", "sin\\theta", "cos\\theta"]
        rows = [] # Populate with data
        table = Table(rows, headers=headers)
        # ... Position table to the right ...

        self.play(Create(unit_circle), Create(p), Write(angle_label), Write(coord_label), Create(table))
        self.wait(1)

        # --- Animation Loop ---
        for i in range(0, 12): # 0 to 360 degrees in 30 degree steps
            theta_deg = i * 30
            theta_rad = np.deg2rad(theta_deg)
            
            # Calculate new coordinates
            new_x = np.cos(theta_rad)
            new_y = np.sin(theta_rad)

            # Animate Point P movement
            self.play(p.animate.move_to(unit_circle.point_from_proportion(theta_rad / (2 * PI))))
            
            # Update labels
            # ... Animate angle_label and coord_label ...

            # Highlight current table row
            # ... Animate table row highlighting ...

            # Color-code sin/cos values in the current row
            # ... Access table cells and apply color based on sign ...

            self.wait(0.5) # Adjust for animation speed

        self.wait(2)

```
