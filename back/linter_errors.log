from manim import *
import numpy as np

class GeneratedScene(Scene):
    def construct(self):
        # 1. Manimで描画すべき図形やテキスト

        # --- 左側：単位円と動的な要素 ---

        # 背景
        plane = NumberPlane(
            x_range=[-1.5, 1.5, 0.5],
            y_range=[-1.5, 1.5, 0.5],
            axis_config={"include_numbers": False},
            background_line_style={"stroke_color": GREY_A}
        )
        circle = Circle(radius=1, color=WHITE)

        # 象限の色分け
        q1 = Sector(outer_radius=1, start_angle=0, angle=PI / 2, color=GREEN_A, fill_opacity=0.2)
        q2 = Sector(outer_radius=1, start_angle=PI / 2, angle=PI / 2, color=BLUE_A, fill_opacity=0.2)
        q3 = Sector(outer_radius=1, start_angle=PI, angle=PI / 2, color=RED_A, fill_opacity=0.2)
        q4 = Sector(outer_radius=1, start_angle=3 * PI / 2, angle=PI / 2, color=YELLOW_A, fill_opacity=0.2)
        sectors = VGroup(q1, q2, q3, q4)

        # 動的な要素 (θに連動)
        theta = ValueTracker(0)

        p_dot = Dot(point=circle.point_at_angle(theta.get_value()), color=RED)
        p_label = MathTex(r"P(\cos\theta, \sin\theta)", font_size=30)
        
        radius_line = Line(ORIGIN, p_dot.get_center(), color=YELLOW)
        arc_theta = Arc(radius=0.3, start_angle=0, angle=theta.get_value(), color=BLUE)
        theta_label = MathTex(r"\theta", font_size=36)
        
        sin_line = Line(p_dot.get_center(), [p_dot.get_x(), 0, 0], color=GREEN)
        cos_line = Line(p_dot.get_center(), [0, p_dot.get_y(), 0], color=PURPLE)

        # 値の表示
        theta_text_label = MathTex(r"\theta = ", font_size=36)
        sin_text_label = MathTex(r"\sin(\theta) = ", font_size=36)
        cos_text_label = MathTex(r"\cos(\theta) = ", font_size=36)
        
        theta_value = DecimalNumber(0, num_decimal_places=0, font_size=36)
        deg_symbol = MathTex(r"^\circ", font_size=36)
        sin_value = DecimalNumber(np.sin(theta.get_value()), num_decimal_places=2, font_size=36)
        cos_value = DecimalNumber(np.cos(theta.get_value()), num_decimal_places=2, font_size=36)

        theta_display = VGroup(theta_text_label, theta_value, deg_symbol).arrange(RIGHT, buff=0.1)
        sin_display = VGroup(sin_text_label, sin_value).arrange(RIGHT, buff=0.1)
        cos_display = VGroup(cos_text_label, cos_value).arrange(RIGHT, buff=0.1)
        
        value_texts = VGroup(theta_display, sin_display, cos_display).arrange(DOWN, aligned_edge=LEFT)
        
        # --- 右側：三角関数の値の表 ---
        
        table_data = [[r"\theta", r"\sin\theta", r"\cos\theta"]]
        for angle_deg in range(0, 361, 30):
            angle_rad = np.deg2rad(angle_deg)
            sin_val = f"{np.sin(angle_rad):.2f}"
            cos_val = f"{np.cos(angle_rad):.2f}"
            if sin_val == "-0.00": sin_val = "0.00"
            if cos_val == "-0.00": cos_val = "0.00"
            table_data.append([f"{angle_deg}^\\circ", sin_val, cos_val])

        table = MathTable(
            table_data,
            include_outer_lines=True,
            line_config={"color": GREY}
        ).scale(0.55) # font_size=28
        
        # --- 全体レイアウト ---
        
        left_group = VGroup(plane, circle, sectors, p_dot, p_label, radius_line, arc_theta, theta_label, sin_line, cos_line, value_texts)
        left_group.to_edge(LEFT, buff=1)
        value_texts.next_to(plane, DOWN, buff=0.5)

        right_group = VGroup(table).to_edge(RIGHT, buff=1)

        highlight_rect = SurroundingRectangle(
            table.get_rows()[1], 
            color=YELLOW_B, 
            fill_opacity=0.3, 
            stroke_width=0,
            buff=0.1
        )

        # --- アップデーターの設定 ---
        
        p_dot.add_updater(lambda m: m.move_to(circle.point_at_angle(theta.get_value())))
        p_label.add_updater(lambda m: m.next_to(p_dot, UR, buff=0.1))
        radius_line.add_updater(lambda m: m.put_start_and_end_on(ORIGIN, p_dot.get_center()))
        arc_theta.add_updater(lambda m: m.become(Arc(radius=0.3, start_angle=0, angle=theta.get_value(), color=BLUE)))
        theta_label.add_updater(
            lambda m: m.move_to(
                Arc(radius=0.45, start_angle=0, angle=theta.get_value()).point_from_proportion(0.5)
            ) if theta.get_value() > 0 else m.set_opacity(0)
        )
        sin_line.add_updater(lambda m: m.put_start_and_end_on(p_dot.get_center(), [p_dot.get_x(), 0, 0]))
        cos_line.add_updater(lambda m: m.put_start_and_end_on(p_dot.get_center(), [0, p_dot.get_y(), 0]))
        
        theta_value.add_updater(lambda d: d.set_value(np.rad2deg(theta.get_value())))
        sin_value.add_updater(lambda d: d.set_value(np.sin(theta.get_value())))
        cos_value.add_updater(lambda d: d.set_value(np.cos(theta.get_value())))

        # 2. 図形やテキストをどのように動かすか
        # 3. シーン全体の流れ

        # 初期セットアップ
        self.add(left_group, right_group)
        self.play(
            Create(plane),
            Create(circle),
            *[FadeIn(s) for s in sectors]
        )
        self.play(FadeIn(table))
        self.play(
            Create(p_dot),
            Create(radius_line),
            Create(arc_theta),
            Create(sin_line),
            Create(cos_line)
        )
        self.play(
            FadeIn(p_label),
            FadeIn(theta_label.set_opacity(0)),
            FadeIn(value_texts)
        )
        self.play(Create(highlight_rect))
        self.wait(1)

        # 角度変化ループ
        for i, angle_deg in enumerate(range(30, 361, 30), start=2):
            target_angle_rad = np.deg2rad(angle_deg)
            target_row = table.get_rows()[i]
            
            self.play(
                theta.animate.set_value(target_angle_rad),
                highlight_rect.animate.move_to(target_row),
                run_time=1
            )
            self.wait(0.5)

        # 最終状態表示
        self.wait(2)
